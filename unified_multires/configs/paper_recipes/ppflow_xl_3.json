{
  "name": "ppflow",
  "image_shape": [
    4,
    32,
    32
  ],
  "model": {
    "name": "native_ppflow",
    "args": {
      "input_size": 32,
      "patch_size": 2,
      "patch_level": 3,
      "in_channels": 4,
      "hidden_size": 1152,
      "depth": 28,
      "num_heads": 16,
      "class_dropout_prob": 0.1,
      "learn_sigma": true
    }
  },
  "training": {
    "optimizer": {
      "lr": 0.0001,
      "betas": [
        0.9,
        0.999
      ],
      "weight_decay": 0.0,
      "ema_decay": 0.9999,
      "randomness": "native_global"
    },
    "data": {
      "shuffle": true,
      "image_size": 256,
      "crop": "adm_center",
      "horizontal_flip": true,
      "flip_rng": "torch",
      "normalization": "torchvision",
      "drop_last": true
    },
    "input_transform": {
      "name": "local_vae",
      "args": {
        "model": {
          "name": "local_autoencoder",
          "args": {
            "path": "@vae@"
          }
        },
        "scale": 0.18215
      }
    },
    "time_sampler": {
      "name": "none"
    },
    "conditioning": {
      "y": {
        "kind": "labels",
        "classes": 1000
      }
    },
    "initialization": {
      "mode": "ppflow_sit",
      "path": "@sit@"
    }
  },
  "batch": {
    "name": "ppflow",
    "args": {
      "levels": 3
    }
  },
  "sampler": {
    "name": "ppflow_native",
    "args": {
      "points": 250,
      "sampling_method": "heun2",
      "cfg_scales": [
        1.0,
        3.5,
        3.75
      ]
    }
  },
