{
  "name": "dfm",
  "image_shape": [
    4,
    32,
    32
  ],
  "model": {
    "name": "adapter",
    "args": {
      "model": {
        "name": "native_dfm",
        "args": {
          "input_size": 32,
          "in_channels": 4,
          "hidden_size": 1152,
          "decoder_hidden_size": 1152,
          "encoder_depth": 8,
          "depth": 28,
          "num_heads": 16,
          "class_dropout_prob": 0.1,
          "enable_repa": false,
          "qk_norm": false
        }
      },
      "output_index": 0
    }
  },
  "training": {
    "optimizer": {
      "lr": 0.0001,
      "weight_decay": 0.0,
      "ema_decay": 0.9999,
      "grad_clip": 1.0,
      "precision": "float16",
      "randomness": "native_global"
    },
    "data": {
      "shuffle": true,
      "image_size": 256,
      "crop": "adm_center",
      "horizontal_flip": true,
      "flip_rng": "torch",
      "normalization": "torchvision",
      "drop_last": true
    },
    "input_transform": {
      "name": "local_vae",
      "args": {
        "model": {
          "name": "local_autoencoder",
          "args": {
            "path": "@vae@"
          }
        },
        "scale": 0.18215
      }
    },
    "time_sampler": {
      "name": "dfm"
    },
    "conditioning": {
      "y": {
        "kind": "labels",
        "classes": 1000
      }
    }
  },
  "batch": {
    "name": "dfm",
    "args": {
      "native_debug_rng": true
    }
  },
  "representation": {
    "name": "laplacian",
    "args": {
      "levels": 2,
      "up": "bilinear",
      "order": "coarse_first"
    }
  },
  "clock": {
    "name": "dfm",
    "args": {
      "steps": [
        40,
        10
      ],
      "thresholds": [
        0.1
      ]
    }
  },
  "guidance": {
    "name": "cfg_window",
    "args": {
      "scale": 1.5,
      "low": 0.0,
      "high": 1.0
    }
  },
  "evidence": {
