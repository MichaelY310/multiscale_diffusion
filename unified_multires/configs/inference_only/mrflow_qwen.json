{
  "name": "mrflow_qwen",
  "model": {
    "name": "qwen_image_transformer",
    "args": {
      "in_channels": 16,
      "out_channels": 4,
      "num_layers": 1,
      "attention_head_dim": 16,
      "num_attention_heads": 2,
      "joint_attention_dim": 8,
      "axes_dims_rope": [
        4,
        6,
        6
      ]
    }
  },
  "vae": {
    "name": "qwen_image_vae",
    "args": {
      "base_dim": 16,
      "z_dim": 4,
      "dim_mult": [
        1,
        2,
        2,
        2
      ],
      "num_res_blocks": 1,
      "latents_mean": [
        0.0,
        0.0,
        0.0,
        0.0
      ],
      "latents_std": [
        1.0,
        1.0,
        1.0,
        1.0
      ]
    }
  },
  "sr_model": {
    "name": "native_rrdb",
    "args": {
      "num_in_ch": 3,
      "num_out_ch": 3,
      "num_feat": 8,
      "num_block": 2,
      "num_grow_ch": 4,
      "scale": 2
    }
  },
  "sampler": {
    "low_size": 32,
    "high_size": 64,
    "low_steps": 12,
    "refine_steps": 1,
    "refine_sigma": 0.12
  },
  "synthetic_fixture": true,
  "synthetic_embedding_shape": [
    1,
    3,
    8
  ],
  "guidance": 4.0
}
